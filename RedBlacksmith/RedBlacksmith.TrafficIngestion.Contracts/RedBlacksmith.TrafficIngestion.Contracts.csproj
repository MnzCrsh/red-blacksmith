<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>RedBlacksmith.TrafficIngestion.Models</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Google.Protobuf" Version="3.36.2" />
        <PackageReference Include="Grpc.Net.Client" Version="2.70.0" />
      <PackageReference Include="Grpc.Tools" Version="2.84.0">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="Protos\traffic_ingestion.proto" GrpcServices="Server" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="RedBlacksmith.TrafficIngestion.Application" />
        <InternalsVisibleTo Include="RedBlacksmith.TrafficIngestion.Core" />
    </ItemGroup>
    
</Project>
