{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Acks": "All",
    "EnableIdempotence": true,
    "LingerMs": 5,
    "CompressionType": "Lz4",
    "Topic": "network.packet-events.v1",
    "BatchSize": "500",
    "FlushIntervalMs": 25
  }
}
