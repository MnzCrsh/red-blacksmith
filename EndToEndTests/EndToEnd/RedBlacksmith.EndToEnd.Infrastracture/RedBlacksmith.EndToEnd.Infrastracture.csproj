<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>RedBlacksmith.EndToEnd</RootNamespace>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>

        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Confluent.Kafka" Version="2.16.0" />
      <PackageReference Include="Google.Protobuf" Version="3.36.2" />
      <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
      <PackageReference Include="Grpc.Tools" Version="2.85.0">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
      <PackageReference Include="Testcontainers" Version="4.16.0" />
      <PackageReference Include="Testcontainers.ClickHouse" Version="4.16.0" />
      <PackageReference Include="Testcontainers.Kafka" Version="4.16.0" />
      <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
      <PackageReference Include="xunit.v3" Version="4.0.3" />
    </ItemGroup>

</Project>
