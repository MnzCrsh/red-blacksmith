<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>

        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Google.Protobuf" Version="3.36.2" />
        <PackageReference Include="Grpc.Net.Client" Version="2.85.0" />
        <PackageReference Include="Grpc.Tools" Version="2.84.0">
            <PrivateAssets>All</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    
    <ItemGroup>
      <ProjectReference Include="..\RedBlacksmith.EndToEnd.Infrastracture\RedBlacksmith.EndToEnd.Infrastracture.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="..\..\..\TrafficIngestion\src\RedBlacksmith.TrafficIngestion.Contracts\Protos\traffic_ingestion.proto" 
                  GrpcServices="Client" />
    </ItemGroup>
    
</Project>
